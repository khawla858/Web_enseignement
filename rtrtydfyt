<?php
session_start();
require_once 'config.php'; // connexion à la BDD

// Vérifie que l'utilisateur est connecté
if (!isset($_SESSION['user_id'])) {
    header('Location: login.php');
    exit;
}

// Récupère l'ID de l'utilisateur connecté
$userId = $_SESSION['user_id'];

// Récupération de la filière du coordinateur connecté
$stmt = $pdo->prepare("SELECT f.* 
                       FROM filieres f
                       JOIN coordinateurs_filieres cf ON f.id = cf.filiere_id
                       WHERE cf.user_id = ?");
$stmt->execute([$userId]);
$filiere = $stmt->fetch();

if (!$filiere) {
    echo "Aucune filière associée à ce coordinateur.";
    exit;
}

// Filtres
$filtre_code = $_GET['code_ue'] ?? '';
$filtre_nom = $_GET['nom_ue'] ?? '';

// Récupération des UE de la filière avec filtres
$query = "SELECT * FROM unites_enseignement 
          WHERE filiere = :filiere 
          AND code_ue LIKE :code 
          AND nom_ue LIKE :nom";
$stmt = $pdo->prepare($query);
$stmt->execute([
    ':filiere' => $filiere['nom'],
    ':code' => "%$filtre_code%",
    ':nom' => "%$filtre_nom%"
]);
$ues = $stmt->fetchAll();
?>

